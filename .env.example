# Copy to .env in this folder (Codestormer/.env) and fill in. .env is gitignored; never commit it.
#   cp .env.example .env

# TypeSafe key for Jev, used by scripts/bottom_up_pipeline.py score.
# Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# The OpenAI key is not read from here. The pipelines read OPENAI_API_KEY and
# OPENAI_BASE_URL from ../backend/.env (env_file in scripts/pipeline_config.json).
